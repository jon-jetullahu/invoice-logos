{
  "name": "profinance-banking-transformation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pro Finance Home – Banking Transformation Intelligence Platform (research database, deterministic 10-year monthly bank model, SaaS UI).",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "npm run data && vitest run",
    "test:py": "cd collection && python3 -m pytest -q tests",
    "typecheck": "tsc --noEmit",
    "report": "npm run data && vite-node scripts/model-report.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
